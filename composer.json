{
    "name": "cycle/testing",
    "description": "Shared Testo test harness for Cycle ORM packages: multi-driver suites, isolation, DB mocks",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "cycle",
        "orm",
        "database",
        "testing",
        "testo"
    ],
    "authors": [
        {
            "name": "Aleksei Gagarin (roxblnfk)",
            "homepage": "https://github.com/roxblnfk"
        }
    ],
    "homepage": "https://cycle-orm.dev",
    "support": {
        "issues": "https://github.com/cycle/testing/issues",
        "source": "https://github.com/cycle/testing"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/cycle"
        }
    ],
    "require": {
        "php": ">=8.2",
        "cycle/database": "^2.23",
        "psr/log": "^2 || ^3",
        "testo/testo": "^0.10.60"
    },
    "require-dev": {
        "bamarni/composer-bin-plugin": "^1.9",
        "cycle/annotated": "^4.6",
        "cycle/orm": "^2.18",
        "cycle/schema-builder": "^2.12",
        "doctrine/collections": "^2.6 || ^3.0",
        "llm/skills": "^1.20",
        "mockery/mockery": "^1.6",
        "testo/bridge-mockery": "^0.1.2"
    },
    "suggest": {
        "cycle/annotated": "Schema\\SchemaCompiler: compile an ORM schema from annotated entities",
        "cycle/orm": "ORM layer (Cycle\\Testing\\ORM)",
        "cycle/schema-builder": "Schema\\SchemaCompiler: compile an ORM schema from annotated entities",
        "llm/skills": "Installs the cycle-testing and testo-* agent skills",
        "testo/bridge-mockery": "Config adds MockeryPlugin to every suite when installed"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Cycle\\Testing\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cycle\\Testing\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true,
            "llm/skills": true
        },
        "sort-packages": true
    },
    "extra": {
        "bamarni-bin": {
            "bin-links": true,
            "forward-command": false,
            "target-directory": "vendor-bin"
        },
        "branch-alias": {
            "dev-1.x": "1.x-dev"
        },
        "skills": {
            "source": "skills"
        }
    },
    "scripts": {
        "db:down": "docker compose -f resources/docker/compose.yaml down -v",
        "db:up": "docker compose -f resources/docker/compose.yaml up -d --wait",
        "cs:diff": "php-cs-fixer fix --dry-run -v --diff --config=vendor-bin/code-style/.php-cs-fixer.dist.php",
        "cs:fix": "php-cs-fixer fix -v --config=vendor-bin/code-style/.php-cs-fixer.dist.php",
        "psalm": "psalm -c vendor-bin/psalm/psalm.xml",
        "psalm:baseline": "psalm -c vendor-bin/psalm/psalm.xml --set-baseline=vendor-bin/psalm/psalm-baseline.xml",
        "psalm:ci": "psalm -c vendor-bin/psalm/psalm.xml --output-format=github --shepherd --show-info=false --stats --threads=4",
        "test": "testo",
        "test:cc": [
            "@putenv XDEBUG_MODE=coverage",
            "testo --suite=Unit --suite=Feature/SQLite --suite=Acceptance/SQLite --suite=Regression/SQLite --coverage"
        ],
        "test:mysql": "testo --suite=Feature/MySQL --suite=Acceptance/MySQL --suite=Regression/MySQL",
        "test:postgres": "testo --suite=Feature/Postgres --suite=Acceptance/Postgres --suite=Regression/Postgres",
        "test:sqlite": "testo --suite=Feature/SQLite --suite=Acceptance/SQLite --suite=Regression/SQLite",
        "test:sqlserver": "testo --suite=Feature/SQLServer --suite=Acceptance/SQLServer --suite=Regression/SQLServer",
        "test:unit": "testo --suite=Unit"
    }
}
