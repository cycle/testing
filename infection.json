{
    "$schema": "vendor-bin/infection/vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": [
            "src"
        ]
    },
    "timeout": 10,
    "minMsi": 90,
    "minCoveredMsi": 90,
    "testFramework": "testo",
    "tmpDir": "runtime",
    "logs": {
        "stryker": {
            "report": "1.x"
        }
    },
    "mutators": {
        "@default": true,
        "IncrementInteger": {
            "ignoreSourceCodeByRegex": [
                ".*limit: 1.*"
            ]
        },
        "LogicalAnd": {
            "ignoreSourceCodeByRegex": [
                ".*\\$a::class === \\$b::class && \\$a == \\$b.*"
            ]
        },
        "UnwrapArrayValues": {
            "ignore": [
                "Cycle\\Testing\\Database\\Internal\\DatabaseInterceptor::connections"
            ]
        }
    }
}
