# Single source of truth for the test databases: docker compose interpolates this file, and
# Cycle\Testing\Database\Env reads it for connection defaults. Exported variables override both.

# Which <Kind>/<Driver> suites Config registers (comma-separated).
DB_DRIVERS=sqlite,mysql,postgres,sqlserver
# 1: an unreachable database fails the tests instead of skipping them (set in CI).
DB_REQUIRED=0

# Empty means in-memory.
DB_SQLITE_FILE=

DB_MYSQL_IMAGE=mysql:8.0
DB_MYSQL_HOST=127.0.0.1
DB_MYSQL_PORT=13306
DB_MYSQL_DATABASE=spiral
DB_MYSQL_USER=root
DB_MYSQL_PASSWORD=YourStrong!Passw0rd
# MySQL 8.4+ removed mysql_native_password: drop that flag when overriding the image with 8.4 or later.
DB_MYSQL_COMMAND=--default-authentication-plugin=mysql_native_password --character-set-server=utf8mb4 --collation-server=utf8mb4_unicode_ci

DB_POSTGRES_IMAGE=postgres:15
DB_POSTGRES_HOST=127.0.0.1
DB_POSTGRES_PORT=15432
DB_POSTGRES_DATABASE=spiral
DB_POSTGRES_USER=postgres
DB_POSTGRES_PASSWORD=YourStrong!Passw0rd

DB_SQLSERVER_IMAGE=mcr.microsoft.com/mssql/server:2022-latest
DB_SQLSERVER_HOST=127.0.0.1
DB_SQLSERVER_PORT=11433
DB_SQLSERVER_DATABASE=tempdb
DB_SQLSERVER_USER=SA
DB_SQLSERVER_PASSWORD=YourStrong!Passw0rd
